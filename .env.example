# MiniDot configuration
# OpenRouter (OpenAI-compatible). Falls back to the OS env var OpenRouterKey if this is unset.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MINIDOT_MODEL=deepseek/deepseek-v4.1-flash

# Browser
MINIDOT_HEADLESS=true
MINIDOT_OPEN_SHOTS=true
MINIDOT_ISOLATE_AGENTS=false
MINIDOT_CDP_URL=http://127.0.0.1:9222
MINIDOT_VIEWPORT=1600x1000
MINIDOT_SHOT_QUALITY=80
MINIDOT_SHOT_SCALE=1
MINIDOT_SHOT_FULLPAGE=false
MINIDOT_SHOT_KEEP=10
MINIDOT_TOOLS_DIR=tools-custom
MINIDOT_MAX_STEPS=12
MINIDOT_TEXT_LIMIT=8000

# Agent name for this CLI window (set automatically by /new)
# MINIDOT_AGENT=main

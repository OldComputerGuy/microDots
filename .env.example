# MiniDot configuration
# OpenRouter (OpenAI-compatible). Falls back to the OS env var OpenRouterKey if this is unset.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MINIDOT_MODEL=deepseek/deepseek-v4.1-flash

# Browser
MINIDOT_HEADLESS=true
MINIDOT_OPEN_SHOTS=true
MINIDOT_ISOLATE_AGENTS=false
MINIDOT_CDP_URL=http://127.0.0.1:9222
MINIDOT_VIEWPORT=1600x1000
MINIDOT_SHOT_QUALITY=80
MINIDOT_SHOT_SCALE=1
MINIDOT_SHOT_FULLPAGE=false
MINIDOT_SHOT_KEEP=10
MINIDOT_TOOLS_DIR=tools-custom
MINIDOT_SKILLS_DIR=skills
# Ask before saving a new tool (set false to auto-approve)
MINIDOT_APPROVE_CREATE_TOOL=true

# Web search (Parallel — same provider as OpenDots). No key needed for light use.
# PARALLEL_API_KEY=

# Tool sandbox for self-authored tools (cross-platform):
#   none = run in-process (full local privileges)
#   any other value (e.g. "sandbox" or "wsl") = run tools in the isolated Linux worker
#     - Windows: the worker runs inside WSL2
#     - Linux:   the worker runs natively (optionally inside bubblewrap)
MINIDOT_TOOL_SANDBOX=none
MINIDOT_SANDBOX_DIR=workspace
MINIDOT_SANDBOX_BWRAP=false
MINIDOT_WSL_DISTRO=Ubuntu-24.04
MINIDOT_WSL_TIMEOUT_MS=60000
MINIDOT_NODE=node
# Extra Chromium flags (e.g. "--no-sandbox") and terminal for /new on Linux
# MINIDOT_CHROMIUM_ARGS=
# MINIDOT_TERMINAL=x-terminal-emulator
MINIDOT_MAX_STEPS=12
MINIDOT_TEXT_LIMIT=32768

# Agent name for this CLI window (set automatically by /new)
# MINIDOT_AGENT=main

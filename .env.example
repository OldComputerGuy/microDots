# MicroDot configuration
# OpenRouter (OpenAI-compatible). Falls back to the OS env var OpenRouterKey if this is unset.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MICRODOT_MODEL=deepseek/deepseek-v4.1-flash
# MICRODOT_VERBOSE=false    # true = show per-tool call/result lines (else a quiet scanner)
# MICRODOT_EXIT_CONFIRM_MS=1000  # while a turn runs: Ctrl-C again within this window stops (idle Ctrl-C is ignored)

# Browser
MICRODOT_HEADLESS=true
MICRODOT_OPEN_SHOTS=true
MICRODOT_ISOLATE_AGENTS=false
MICRODOT_CDP_URL=http://127.0.0.1:9222
MICRODOT_VIEWPORT=1600x1000
MICRODOT_SHOT_QUALITY=80
MICRODOT_SHOT_SCALE=1
MICRODOT_SHOT_FULLPAGE=false
MICRODOT_SHOT_KEEP=10
# On exit an agent closes its tab, stops the shared Chromium if last, and removes
# its screenshots. Set true to keep screenshots.
# MICRODOT_KEEP_SHOTS=false
# Layers: engine (install dir + shipped defaults) + project (<launch dir>/.microdot).
# Tools/skills/worker-types resolve engine+project (project overrides); new ones
# are written to the project. Set these only to force a single directory:
# MICRODOT_HOME=             # engine dir (code + shipped defaults + Chromium profile)
# MICRODOT_TOOLS_DIR=        # single tools dir
# MICRODOT_SKILLS_DIR=       # single skills dir
# MICRODOT_WORKER_TYPES_DIR= # single worker-types dir
# MICRODOT_CHATS_DIR=        # single chats dir (default <launch>/.microdot/chats)
# Projects: named workspaces (chats/spaces/mission/notes) — not folders you
# navigate. Switch at runtime with /project <name>; the current one is remembered.
# MICRODOT_PROJECT=          # current project name (else the launch folder)
# MICRODOT_DATA_DIR=         # data dir (default <install>/.microdot, gitignored)
# MICRODOT_PROJECTS_DIR=     # where projects live (default <data>/projects)
# Offloaded tool outputs (spaces/<worker>/notes/) are pruned on exit:
# MICRODOT_PRUNE_NOTES=true
# MICRODOT_NOTES_KEEP=400    # keep the newest N note files
# MICRODOT_NOTES_MAX_MB=25   # ...within this total size
# Default worker type for a new worker (overridden per worker via /new <name> <type>)
# MICRODOT_WORKER_TYPE=default
# New tools are saved without asking. Set true to be prompted for risky code.
MICRODOT_APPROVE_CREATE_TOOL=false

# Web search (Parallel — same provider as OpenDots). No key needed for light use.
# The anonymous tier is rate-limited and search is metered (~$1 / 1000 searches).
# Results are cached in-process (identical queries are free) and 429s are retried
# with backoff. Set PARALLEL_API_KEY (alias: PARALLEL_KEY) for a higher tier; cap
# searches per session with MICRODOT_SEARCH_MAX (0 = unlimited).
# PARALLEL_API_KEY=
# MICRODOT_SEARCH_MAX=0

# Self-authored tools run ONLY in an isolated Linux worker:
#   - Windows: inside WSL2      - Linux: natively (optionally under bubblewrap)
# There is no in-process / host fallback; if the worker can't start, custom
# tools are refused. (Built-in tools always run on the host.)
# Each worker gets its own space in the project layer: .microdot/spaces/<worker_name>/
# (mission.md + files). The space is also the sandbox root, so tool writes land there.
# MICRODOT_SPACE=main        # override the space name (defaults to the worker name)
# MICRODOT_MISSION=...       # initial mission.md text if the file doesn't exist
# MICRODOT_SANDBOX_DIR=      # advanced: explicit sandbox root, overrides spaces/<worker>
MICRODOT_SANDBOX_BWRAP=false
MICRODOT_WSL_DISTRO=Ubuntu-24.04
MICRODOT_WSL_TIMEOUT_MS=60000
MICRODOT_NODE=node
# Extra Chromium flags (e.g. "--no-sandbox") and terminal for /new on Linux
# MICRODOT_CHROMIUM_ARGS=
# MICRODOT_TERMINAL=x-terminal-emulator
# Sub-agents (on by default): an agent can spawn specialized sub-agents that run
# autonomously and report findings back up the tree. Their spaces are nested
# under the parent's (.microdot/spaces/<worker>/subagents/<name>/) and cleaned up
# at the end of the run. Set false to disable; MICRODOT_DEBUG=true to keep them.
MICRODOT_ALLOW_SPAWN=true
MICRODOT_MAX_DEPTH=3
MICRODOT_MAX_AGENTS=16
MICRODOT_MAX_CONCURRENT=8
# MICRODOT_DEBUG=true

MICRODOT_MAX_STEPS=12
MICRODOT_TEXT_LIMIT=32768
# Or budget tool results in tokens instead of characters (approximate: tokens x chars/token):
# MICRODOT_TEXT_TOKENS=12000
# MICRODOT_CHARS_PER_TOKEN=4

# Context compaction (trim + summarize) and offload of large tool outputs
MICRODOT_COMPACT=false
MICRODOT_CONTEXT_TOKENS=24000
MICRODOT_KEEP_RECENT=6
MICRODOT_OFFLOAD_TOKENS=4000
# MICRODOT_SUMMARY_MODEL=qwen/qwen3.6-flash   # cheap summarizer (falls back to MICRODOT_MODEL on failure)

# Agent name for this CLI window (set automatically by /new)
# MICRODOT_AGENT=main

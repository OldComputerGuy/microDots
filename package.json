{
  "name": "microdot",
  "version": "0.1.0",
  "private": true,
  "description": "MicroDot - a bare-bones single agent with a CLI and a Playwright browser. No CopilotKit, no React, no server.",
  "type": "module",
  "bin": {
    "microdot": "src/cli.mjs"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/cli.mjs",
    "once": "node --env-file-if-exists=.env src/cli.mjs --prompt"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "playwright": "^1.63.0"
  }
}
